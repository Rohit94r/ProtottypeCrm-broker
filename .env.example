# Nexus CRM — Frontend Demo (Mock Mode)
# All API calls are intercepted by src/lib/mockApi.ts — no backend required.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Employee Tracking map uses OpenStreetMap + Leaflet (no API key required).

# Supabase Realtime (instant in-app notifications) — disabled in demo mode
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Firebase Web Push (Android Chrome + PWA) — disabled in demo mode
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
# EXPO_PUBLIC_FIREBASE_VAPID_KEY=   # Cloud Messaging → Web Push certificates
